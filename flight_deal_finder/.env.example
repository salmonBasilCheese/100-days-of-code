# Sheety API 設定 (https://sheety.co/)
SHEETY_ENDPOINT=https://api.sheety.co/your_username/flightDeals/prices
SHEETY_TOKEN=your_sheety_bearer_token

# SerpAPI 設定 (https://serpapi.com/)
SERP_API_KEY=your_serpapi_key

# Discord Webhook 通知先
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 出発地空港 IATA コード (デフォルト: TYO - 東京全域)
ORIGIN_IATA=TYO